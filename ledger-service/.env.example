SERVICE_NAME=ledger-service
SERVICE_VERSION=0.0.0-SNAPSHOT
HTTP_ADDRESS=:8080
LOG_LEVEL=info
ENVIRONMENT=local
SHUTDOWN_TIMEOUT=50s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# DEVELOPMENT-ONLY connection used with the documented Kubernetes port-forward.
# Never reuse these credentials outside a disposable local cluster.
DATABASE_URL=postgres://ledger_app:ledger_app_local_not_for_production@localhost:5432/ledger_db?sslmode=disable
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTION_LIFETIME=30m
DB_MAX_CONNECTION_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s
DB_CONNECT_TIMEOUT=5s
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY=2s
